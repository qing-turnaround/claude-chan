{
  "name": "claude-chan",
  "version": "0.2.3",
  "description": "An anime desktop pet for Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "qing-turnaround",
    "email": "71116975+qing-turnaround@users.noreply.github.com"
  },
  "build": {
    "appId": "com.qing.claudechan",
    "productName": "Claude-chan",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "claude-hooks.js",
      "assets/**",
      "i18n.js",
      "critters.js",
      "critter.html",
      "settings.html",
      "settings.js",
      "settings-preload.js",
      "approvals.js",
      "approvals.html",
      "approvals-ui.js",
      "approvals-preload.js",
      "critter-renderer.js",
      "critter-preload.js",
      "updater.js",
      "holidays.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Claude-chan-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude-chan",
      "artifactName": "Claude-chan-Setup-${version}-${arch}.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "zh_TW",
        "ja_JP"
      ],
      "buildUniversalInstaller": false,
      "differentialPackage": true
    },
    "electronLanguages": [
      "en-US",
      "en",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "ja"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Claude-chan-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "claude-chan",
      "maintainer": "qing-turnaround <71116975+qing-turnaround@users.noreply.github.com>",
      "artifactName": "Claude-chan-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qing-turnaround",
        "repo": "claude-chan"
      }
    ]
  },
  "homepage": "https://github.com/qing-turnaround/claude-chan",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
